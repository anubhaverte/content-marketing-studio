<?xml version="1.0" encoding="UTF-8"?>
{# Phase 1 print proof. 1 SVG unit = 1 mm; the 60x92 mm canvas includes 3 mm bleed. #}
<svg xmlns="http://www.w3.org/2000/svg" width="60mm" height="92mm" viewBox="0 0 60 92">
  <style>
    @font-face {
      font-family: "{{ font_family }}";
      src: url("{{ fonts.regular }}") format("truetype");
      font-weight: 400;
    }
    @font-face {
      font-family: "{{ font_family }}";
      src: url("{{ fonts.bold }}") format("truetype");
      font-weight: 700;
    }
  </style>
  <!-- Background goes all the way to the edge (into the bleed) -->
  <rect x="0" y="0" width="60" height="92" fill="{{ colors.background }}"/>
  <rect x="0" y="0" width="60" height="24" fill="{{ colors.primary }}"/>

  <!-- Logos (aspect ratio kept with "meet", never stretched) -->
  <image href="{{ logos.acm_nitsurat }}" x="8" y="8" width="19" height="9.5" preserveAspectRatio="xMidYMid meet"/>
  <image href="{{ logos.svnit }}" x="33" y="8" width="19" height="9.5" preserveAspectRatio="xMidYMid meet"/>

  <!-- Photo placeholder -->
  <rect x="16" y="28" width="28" height="34" rx="3" fill="{{ colors.secondary }}" stroke="{{ colors.accent }}" stroke-width="0.4"/>
  <text x="30" y="46" text-anchor="middle" font-family="{{ font_family }}" font-size="{{ 6|pt_to_mm }}" fill="{{ colors.primary }}">PHOTO</text>

  <!-- Dashed line -->
  <line x1="10" y1="64.5" x2="50" y2="64.5" stroke="{{ colors.accent }}" stroke-width="0.4" stroke-dasharray="2 1.5"/>

  <!-- Name -->
  <text x="30" y="71" text-anchor="middle" font-family="{{ font_family }}" font-weight="bold"
        font-size="{{ 12|pt_to_mm }}" fill="{{ colors.text }}">{{ name }}</text>

  <!-- Role badge -->
  <rect x="15" y="78" width="30" height="6" rx="1" fill="{{ role_color }}"/>
  <text x="30" y="82.1" text-anchor="middle" font-family="{{ font_family }}" font-weight="bold"
        font-size="{{ 7|pt_to_mm }}" fill="#FFFFFF">{{ role|upper }}</text>

{% if debug_guides %}
  <!-- Guides: red = trim line (final cut), green = safe area -->
  <rect x="3" y="3" width="54" height="86" fill="none" stroke="#E03131" stroke-width="0.2" stroke-dasharray="1 1"/>
  <rect x="7" y="7" width="46" height="78" fill="none" stroke="#2F9E44" stroke-width="0.2" stroke-dasharray="1 1"/>
{% endif %}
</svg>
