# ==============================================================================
# ACM NIT Surat — ID Card Studio (Environment Configuration)
# ==============================================================================
# Copy this file to .env or backend/.env and populate your values.
# Real credentials must never be committed to source control.

# Google Gemini API Key (Optional)
# Used for natural-language event brief extraction and spec refinement suggestions.
# If omitted, the engine automatically operates in full offline deterministic mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Service Configuration (Optional)
# Default port is 8000.
PORT=8000

# Frontend Next.js API Gateway (Optional)
# Defaults to http://localhost:8000 if not specified.
NEXT_PUBLIC_API_URL=http://localhost:8000
