  "additionalProperties": false,
  "description": "Layout + theme + brand kit + event info merged. The renderer reads this (Phase 2).",
  "properties": {
    "brand": {
      "$ref": "#/$defs/BrandKit"
    },
    "elements": {
      "items": {
        "discriminator": {
          "mapping": {
            "circle": "#/$defs/CircleEl",
            "line": "#/$defs/LineEl",
            "logo": "#/$defs/LogoEl",
            "photo": "#/$defs/PhotoEl",
            "qr": "#/$defs/QrEl",
            "rect": "#/$defs/RectEl",
            "role_badge": "#/$defs/RoleBadgeEl",
            "svg_asset": "#/$defs/SvgAssetEl",
            "text": "#/$defs/TextEl"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RectEl"
          },
          {
            "$ref": "#/$defs/LineEl"
          },
          {
            "$ref": "#/$defs/CircleEl"
          },
          {
            "$ref": "#/$defs/TextEl"
          },
