        "angle": {
          "default": 0,
          "title": "Angle",
          "type": "number"
        },
        "gradient": {
          "const": "linear",
          "title": "Gradient",
          "type": "string"
        },
        "stops": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Stops",
          "type": "array"
        }
      },
      "required": [
        "gradient",
        "stops"
