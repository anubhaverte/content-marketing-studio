          },
          {
            "$ref": "#/$defs/QrEl"
          },
          {
            "$ref": "#/$defs/SvgAssetEl"
          }
        ]
      },
      "title": "Elements",
      "type": "array"
    },
    "event": {
      "$ref": "#/$defs/EventInfo",
      "default": {
        "dates": null,
        "event_name": null,
        "tagline": null,
        "venue": null
      }
    },
    "layout_name": {
      "title": "Layout Name",
      "type": "string"
    },
    "page": {
