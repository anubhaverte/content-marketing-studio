    "CircleEl": {
      "additionalProperties": false,
      "properties": {
        "cx": {
          "title": "Cx",
          "type": "number"
        },
        "cy": {
          "title": "Cy",
          "type": "number"
        },
        "fill": {
          "default": "none",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/GradientFill"
            }
          ],
          "title": "Fill"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "r": {
          "exclusiveMinimum": 0,
          "title": "R",
          "type": "number"
        },
        "stroke": {
          "default": "none",
          "title": "Stroke",
          "type": "string"
        },
        "stroke_width": {
          "default": 0,
          "minimum": 0,
          "title": "Stroke Width",
          "type": "number"
        },
        "type": {
          "const": "circle",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "cx",
        "cy",
        "r"
      ],
      "title": "CircleEl",
      "type": "object"
    },
    "GradientFill": {
      "additionalProperties": false,
      "description": "A gradient fill. Stops use theme tokens: [[0.0, \"primary\"], [1.0, \"background\"]].",
