{
  "name": "ID Card Studio (FastAPI + Next.js)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "sudo apt update && sudo apt install -y libcairo2 libgl1 libglib2.0-0 && pip3 install --user -r backend/requirements.txt && echo '✅ Native graphics and Python dependencies installed'",
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend API",
      "onAutoForward": "silent"
    },
    "3000": {
      "label": "Next.js Frontend UI",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    3000
  ]
}